# =========================================================
# Crypto Research Workbench
# Example environment configuration
# =========================================================

# ---------------------------------------------------------
# Global
# ---------------------------------------------------------
COMPOSE_PROJECT_NAME=crypto-research-workbench
TZ=UTC
PROJECT_NAME=Crypto Research Workbench
ENVIRONMENT=dev

# ---------------------------------------------------------
# Ports
# ---------------------------------------------------------
POSTGRES_PORT=5432
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
AIRFLOW_WEBSERVER_PORT=8080
SUPERSET_PORT=8088
KAFKA_EXTERNAL_PORT=9092
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_UI_PORT=8082

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------
POSTGRES_DB=crypto_platform
POSTGRES_USER=crypto_admin
POSTGRES_PASSWORD=change_me_postgres_password

# Airflow metadata DB
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_db_password

# ---------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------
CLICKHOUSE_DB=crypto
CLICKHOUSE_USER=crypto_user
CLICKHOUSE_PASSWORD=change_me_clickhouse_password
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# ---------------------------------------------------------
# MinIO
# ---------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
MINIO_BUCKET_CHECKPOINTS=checkpoints

# S3 / MinIO access for jobs
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_minio_password
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PATH_STYLE_ACCESS=true

# ---------------------------------------------------------
# Airflow
# ---------------------------------------------------------
AIRFLOW_FERNET_KEY=change_me_fernet_key_32_chars_or_more
AIRFLOW_SECRET_KEY=change_me_airflow_secret_key
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=False
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin_password
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------
# Superset
# ---------------------------------------------------------
SUPERSET_SECRET_KEY=change_me_superset_secret_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin_password
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------
# Kafka
# ---------------------------------------------------------
KAFKA_BROKER_ID=1
KAFKA_NODE_ID=1
KAFKA_CLUSTER_ID=kraft-cluster-001
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# Kafka topics
KAFKA_TOPIC_TRADES_RAW=trades.raw
KAFKA_TOPIC_KLINES_RAW=klines.raw

# ---------------------------------------------------------
# Spark
# ---------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SQL_TIMEZONE=UTC

# ---------------------------------------------------------
# Data ingestion / research defaults
# ---------------------------------------------------------
DEFAULT_EXCHANGE=binance
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
DEFAULT_KLINE_INTERVAL=1m
DEFAULT_BACKFILL_DAYS=30

# ---------------------------------------------------------
# Paths / object storage prefixes
# ---------------------------------------------------------
BRONZE_KLINES_PREFIX=klines/
BRONZE_TRADES_PREFIX=trades/
BRONZE_METADATA_PREFIX=metadata/

SILVER_KLINES_PREFIX=klines/
SILVER_TRADES_PREFIX=trades/
SILVER_METADATA_PREFIX=metadata/

GOLD_PREFIX=marts/

# ---------------------------------------------------------
# Logging / debug
# ---------------------------------------------------------
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1